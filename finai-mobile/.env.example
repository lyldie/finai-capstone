# Google Cloud OAuth Web client ID; configure this in the EAS preview environment too.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client ID (required for iOS sign-in).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Google's reversed iOS client ID (com.googleusercontent.apps.*), required for iOS builds.
GOOGLE_IOS_URL_SCHEME=
