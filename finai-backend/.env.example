# Copy to .env and fill these values before starting the backend.
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
ADMIN_JWT_SECRET=<long-random-secret>
SUPER_ADMIN_EMAIL=<email-of-existing-admin-account>
EMAIL_SENDER=<smtp-sender-address>
EMAIL_PASSWORD=<smtp-app-password>
EMAIL_TEST_RECIPIENT=<optional-test-recipient>
GEMINI_API_KEY=<gemini-api-key>
GEMINI_OCR_TIMEOUT_SECONDS=10
