# Copy to .env and fill these values before starting the backend.
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
MONGO_DB_NAME=FinAI_DB
ADMIN_JWT_SECRET=<long-random-secret>
# Google OAuth Web client ID (or comma-separated allowed IDs) used to verify mobile ID tokens.
GOOGLE_OAUTH_CLIENT_IDS=<google-web-client-id>
SUPER_ADMIN_EMAIL=<email-of-existing-admin-account>
EMAIL_SENDER=<smtp-sender-address>
EMAIL_PASSWORD=<smtp-app-password>
EMAIL_TEST_RECIPIENT=<optional-test-recipient>
# Comma-separated browser origins allowed to call the API. Native Android/iOS apps do not use CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
GEMINI_API_KEY=<gemini-api-key>
# Tried in order. The backup is attempted for transient provider errors or invalid model output.
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_BACKUP_MODEL=gemini-3.6-flash
GEMINI_OCR_TIMEOUT_SECONDS=10
# Optional cross-provider fallback for chat, proactive chat insights, and Plan Ahead.
GROQ_API_KEY=<groq-api-key>
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_PLANNING_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=4
# Optional final AI fallback for Chat and Plan Ahead; authenticates with the Cloud Run service account (ADC).
VERTEX_AI_ENABLED=false
VERTEX_AI_PROJECT_ID=<google-cloud-project-id>
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-3.8-flash
VERTEX_AI_TIMEOUT_SECONDS=8
